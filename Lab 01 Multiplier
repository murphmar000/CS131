/* Write a C++ program that asks the user for three numbers.
Multiply the first two numbers together, then add the third number to that (mathematically this is a linear equation) */

#include <iostream>
using namespace std;

int main()
{
    int first_number, second_number, third_number;
    cout << "What is your first number? ";
    cin >> first_number;
    cout << "What is your second number? ";
    cin >> second_number;
    cout << "What is your third number?" ;
    cin >> third_number;
//multiplication and addition
    cout << first_number << " times " << second_number << " plus " << third_number;
    cout << " is " << (first_number * second_number) + third_number << "\n\n";
}
