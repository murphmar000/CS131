#include <iostream>
using namespace std;

//the custom function code
char gradeTranslator(int score){
    if (score >= 90) {
        return 'A';
    }
    else if (score >= 80) {
        return 'B';
    }
    else if (score >= 70) {
        return 'C';
    }
    else if (score >= 60) {
        return 'D';
    }
    else {
        return 'F';
    }
}


//main body of code
int main() {
    //declare the testscore variable
    int testscore;
    
    //ask for a numerical test score
    cout << "Enter a test score between 0 and 100 to check your grade: ";
    cin >> testscore;
    
    //call the custom function we created to calculate the letter grade
    char grade = gradeTranslator(testscore);
    
    cout << "Yout grade is: " << grade << endl;
    
    return 0;
}
