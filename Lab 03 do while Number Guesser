#include <iostream>
//added in header
#include <stdlib.h>
#include <time.h>

//allows use of cin & cout without having to include std:: before them each time
using namespace std;

//main body of code
int main() {
    //added in main body
    int numberToGuess, numberGuessed, numberOfGuesses=3;
    int guessesMade = 0;
    //initialize random number
    srand(time(NULL));
    numberToGuess = rand() % 10 + 1;
    
    cout << "Guess a number between 1 and 10. You have 3 tries.\n";
    //use do-while for the user guesses
    do {
        cout << "Guess #" << (guessesMade + 1) << ": ";
        cin >> numberGuessed;
                //the ++ adds 1 each time the user makes a guess
                guessesMade++;

                if (numberGuessed < numberToGuess) {
                    cout << "Higher.\n";
                } else if (numberGuessed > numberToGuess) {
                    cout << "Lower.\n";
                } else {
                    cout << "That is the correct number.\n";
                    return 0;
                }
        
    } while (guessesMade < numberOfGuesses);
    
    //if the user doesn't make the correct guess in 3 tries, it exits the do-while loop
    cout << "The correct number was " << numberToGuess << ".\n";
    
    //ends the program
    return 0;
}
